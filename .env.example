# Copy to .env and fill in both values; docker compose refuses to start while either is empty.

# Password of the `chess` PostgreSQL user (the API uses the same credentials).
POSTGRES_PASSWORD=

# HS256 key for the session tokens, at least 16 characters; generate one with: openssl rand -base64 48
JWT_SECRET=

# Public hostname for HTTPS (Caddy obtains the certificate automatically once DNS points here).
# Leave empty for plain HTTP on localhost.
SITE_ADDRESS=
# Optional "www." hostname that redirects to SITE_ADDRESS (needs its own DNS record).
WWW_ADDRESS=

# CPUs the engine service may use (docker compose CPU limit); the rest stays for the API and
# the database. Default 6; set it to the host's cores minus two or so.
ENGINE_CPUS=
# Search threads of the engine service; empty means the CPUs it is allowed to use.
ENGINE_PARALLELISM=
