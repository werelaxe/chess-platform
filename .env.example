# Copy to .env and fill in both values; docker compose refuses to start while either is empty.

# Password of the `chess` PostgreSQL user (the API uses the same credentials).
POSTGRES_PASSWORD=

# HS256 key for the session tokens, at least 16 characters; generate one with: openssl rand -base64 48
JWT_SECRET=

# Public hostname for HTTPS (Caddy obtains the certificate automatically once DNS points here).
# Leave empty for plain HTTP on localhost.
SITE_ADDRESS=
